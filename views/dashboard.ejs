<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Lost and Found</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background: #f1f5f9;
            color: #1e293b;
        }

        nav {
            background: #172554;
            color: white;
            padding: 18px 7%;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin-left: 20px;
        }

        .container {
            width: 86%;
            margin: 40px auto;
        }

        .welcome {
            background: linear-gradient(120deg, #2563eb, #4f46e5);
            color: white;
            padding: 35px;
            border-radius: 15px;
            margin-bottom: 30px;
        }

        .welcome h1 {
            margin-bottom: 12px;
        }

        .section-title {
            margin: 25px 0 18px;
        }

        .cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 22px;
        }

        .card {
            background: white;
            padding: 28px;
            border-radius: 13px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.06);
        }

        .card h2 {
            font-size: 22px;
            margin-bottom: 12px;
        }

        .card p {
            color: #64748b;
            line-height: 1.5;
            margin-bottom: 20px;
        }

        .card a {
            display: inline-block;
            background: #2563eb;
            color: white;
            text-decoration: none;
            padding: 11px 18px;
            border-radius: 7px;
        }

        .card a:hover {
            background: #1d4ed8;
        }

        .footer {
            text-align: center;
            padding: 25px;
            color: #64748b;
        }

        @media(max-width: 600px) {
            nav {
                flex-direction: column;
                gap: 15px;
            }

            nav a {
                margin: 0 8px;
            }

            .container {
                width: 92%;
            }
        }
    </style>
</head>

<body>

    <nav>
        <h2>🔍 Lost & Found</h2>
        <div>
            <a href="/">Home</a>
            <a href="/logout">Logout</a>
        </div>
    </nav>

    <div class="container">

        <div class="welcome">
            <h1>Welcome, <%= user.name %>! 👋</h1>
            <p>
                Welcome to the Lost and Found Management System.
                Report lost belongings and help people find their missing items.
            </p>
        </div>

        <h2 class="section-title">Manage Your Items</h2>

        <div class="cards">

            <div class="card">
                <h2>🔎 Search Items</h2>
                <p>Search lost and found belongings by name or category.</p>
                <a href="/search">Search Items</a>
            </div>

            <div class="card">
                <h2>🔴 Report Lost Item</h2>
                <p>Submit information about your missing belongings.</p>
                <a href="/report-lost">Report Lost Item</a>
            </div>

            <div class="card">
                <h2>🟢 Report Found Item</h2>
                <p>Share details about an item you have found.</p>
                <a href="/report-found">Report Found</a>
            </div>

            <div class="card">
                <h2>📋 View Lost Items</h2>
                <p>Browse reported lost belongings.</p>
                <a href="/items">View Lost Items</a>
            </div>

            <div class="card">
                <h2>📦 View Found Items</h2>
                <p>Browse reported found belongings.</p>
                <a href="/found-items">View Found Items</a>
            </div>

            <div class="card">
                <h2>🤝 Match Items</h2>
                <p>Find possible matches between lost and found items.</p>
                <a href="/matches">Find Matches</a>
            </div>

        </div>

        <h2 class="section-title">Account Information</h2>

        <div class="card">
            <h2>👤 My Profile</h2>
            <p>Name: <%= user.name %></p>
            <p>Email: <%= user.email %></p>
            <a href="/logout">Logout</a>
        </div>

    </div>

    <div class="footer">
        <p>© 2026 Lost and Found Management System</p>
    </div>

</body>
</html>