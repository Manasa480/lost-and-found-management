<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Lost & Found | Find What's Missing</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', Arial, sans-serif;
}

html {
    scroll-behavior: smooth;
}

body {
    background: #f5f7ff;
    color: #172554;
}

/* NAVBAR */
nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 8%;
    background: white;
    box-shadow: 0 3px 15px rgba(0,0,0,0.06);
}

.logo {
    font-size: 25px;
    font-weight: bold;
    color: #4338ca;
}

nav ul {
    display: flex;
    list-style: none;
    gap: 30px;
}

nav a {
    text-decoration: none;
    color: #334155;
    font-weight: 600;
}

nav a:hover {
    color: #6366f1;
}

/* HERO */
.hero {
    min-height: 520px;
    padding: 90px 8%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    background: linear-gradient(120deg,#312e81,#4f46e5,#818cf8);
    color: white;
}

.hero-content {
    max-width: 580px;
}

.hero h1 {
    font-size: 52px;
    line-height: 1.2;
    margin-bottom: 22px;
}

.hero p {
    font-size: 18px;
    line-height: 1.8;
    color: #e0e7ff;
    margin-bottom: 30px;
}

.hero-art {
    font-size: 150px;
    background: rgba(255,255,255,0.12);
    padding: 35px;
    border-radius: 40px;
}

.btn {
    display: inline-block;
    padding: 14px 24px;
    margin: 5px;
    border-radius: 9px;
    text-decoration: none;
    font-weight: bold;
    transition: 0.3s;
}

.btn-white {
    background: white;
    color: #4338ca;
}

.btn-outline {
    border: 2px solid white;
    color: white;
}

.btn:hover {
    transform: translateY(-4px);
}

/* SECTIONS */
section {
    padding: 75px 8%;
}

.section-title {
    text-align: center;
    margin-bottom: 40px;
}

.section-title h2 {
    font-size: 34px;
    color: #312e81;
    margin-bottom: 12px;
}

.section-title p {
    color: #64748b;
}

/* CARDS */
.cards {
    display: grid;
    grid-template-columns: repeat(3,1fr);
    gap: 25px;
}

.card {
    background: white;
    padding: 30px;
    border-radius: 16px;
    box-shadow: 0 5px 25px rgba(0,0,0,0.06);
    transition: 0.3s;
}

.card:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 30px rgba(79,70,229,0.13);
}

.card .icon {
    font-size: 45px;
    margin-bottom: 18px;
}

.card h3 {
    color: #3730a3;
    margin-bottom: 12px;
}

.card p {
    color: #64748b;
    line-height: 1.7;
}

/* HOW IT WORKS */
.steps {
    background: #eef2ff;
}

.step-number {
    display: inline-flex;
    width: 48px;
    height: 48px;
    justify-content: center;
    align-items: center;
    background: #4f46e5;
    color: white;
    border-radius: 50%;
    font-size: 20px;
    font-weight: bold;
    margin-bottom: 18px;
}

/* CTA */
.cta {
    text-align: center;
    background: linear-gradient(120deg,#4338ca,#6366f1);
    color: white;
    border-radius: 20px;
    margin: 60px 8%;
    padding: 60px 20px;
}

.cta h2 {
    font-size: 32px;
    margin-bottom: 15px;
}

.cta p {
    margin-bottom: 25px;
    color: #e0e7ff;
}

/* FOOTER */
footer {
    background: #172554;
    color: white;
    text-align: center;
    padding: 30px 15px;
    line-height: 2;
}

/* RESPONSIVE */
@media(max-width:850px) {
    .hero {
        flex-direction: column;
        text-align: center;
        padding: 65px 6%;
    }

    .hero h1 {
        font-size: 38px;
    }

    .hero-art {
        font-size: 90px;
    }

    .cards {
        grid-template-columns: 1fr;
    }

    nav {
        flex-direction: column;
        gap: 18px;
    }

    nav ul {
        gap: 15px;
        flex-wrap: wrap;
        justify-content: center;
    }
}
</style>
</head>

<body>

<!-- NAVBAR -->
<nav>
    <div class="logo">🔎 Lost & Found</div>

    <ul>
        <li><a href="/">Home</a></li>
        <li><a href="#features">Features</a></li>
        <li><a href="#how">How It Works</a></li>
        <li><a href="#contact">Contact</a></li>
        <li><a href="/login">Login</a></li>
<li><a href="/register">Register</a></li>
    </ul>
</nav>

<!-- HERO SECTION -->
<div class="hero">
    <div class="hero-content">
        <h1>Lost Something? Let's Find It Together!</h1>

        <p>
            Welcome to Lost and Found Management System.
            A simple platform to report lost belongings,
            share found items and help people reconnect
            with their valuable possessions.
        </p>

        <a href="#how" class="btn btn-white">
            Get Started →
        </a>

        <a href="#features" class="btn btn-outline">
            Explore More
        </a>
    </div>

    <div class="hero-art">
        🔍 🎒
    </div>
</div>

<!-- FEATURES -->
<section id="features">

    <div class="section-title">
        <h2>What Can You Do?</h2>
        <p>Everything you need in one place.</p>
    </div>

    <div class="cards">

        <div class="card">
            <div class="icon">📱</div>
            <h3>Report Lost Items</h3>
            <p>
                Report your missing mobile phones,
                bags, documents and other belongings
                with item details.
            </p>
        </div>

        <div class="card">
            <div class="icon">🎒</div>
            <h3>Report Found Items</h3>
            <p>
                Help others by submitting information
                about items you have found.
            </p>
        </div>

        <div class="card">
            <div class="icon">🤝</div>
            <h3>Reconnect Items</h3>
            <p>
                Make it easier for owners to identify
                and recover their missing belongings.
            </p>
        </div>

    </div>
</section>

<!-- HOW IT WORKS -->
<section class="steps" id="how">

    <div class="section-title">
        <h2>How It Works</h2>
        <p>Three simple steps to get started.</p>
    </div>

    <div class="cards">

        <div class="card">
            <div class="step-number">1</div>
            <h3>Create a Report</h3>
            <p>
                Provide details about your lost
                or found item.
            </p>
        </div>

        <div class="card">
            <div class="step-number">2</div>
            <h3>Search Items</h3>
            <p>
                Browse available reports and
                identify matching belongings.
            </p>
        </div>

        <div class="card">
            <div class="step-number">3</div>
            <h3>Recover Your Item</h3>
            <p>
                Contact the concerned person and
                arrange safe recovery.
            </p>
        </div>

    </div>
</section>

<!-- CTA -->
<div class="cta">
    <h2>Every Lost Item Deserves a Second Chance!</h2>

    <p>
        Join our platform and help make lost
        belongings found again.
    </p>

    <a href="#features" class="btn btn-white">
        Explore Features
    </a>
</div>

<!-- FOOTER -->
<footer id="contact">
    <h3>🔎 Lost & Found Management System</h3>

    <p>Connecting people with their lost belongings.</p>

    <p>© 2026 Lost & Found. All Rights Reserved.</p>
</footer>

</body>
</html>