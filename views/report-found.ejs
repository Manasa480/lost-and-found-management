<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Report Found Item - Lost & Found</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background: #f1f5f9;
            color: #1e293b;
        }

        nav {
            background: #166534;
            color: white;
            padding: 18px 7%;
        }

        nav a {
            color: white;
            text-decoration: none;
        }

        .container {
            max-width: 750px;
            margin: 35px auto;
            padding: 30px;
            background: white;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        }

        h1 {
            color: #166534;
            margin-bottom: 10px;
        }

        .subtitle {
            color: #64748b;
            margin-bottom: 25px;
        }

        label {
            display: block;
            margin: 16px 0 7px;
            font-weight: bold;
        }

        input, select, textarea {
            width: 100%;
            padding: 12px;
            border: 1px solid #cbd5e1;
            border-radius: 7px;
            font-size: 15px;
        }

        textarea {
            height: 100px;
            resize: vertical;
        }

        button {
            width: 100%;
            padding: 14px;
            margin-top: 22px;
            border: none;
            border-radius: 7px;
            background: #16a34a;
            color: white;
            font-size: 17px;
            cursor: pointer;
        }

        button:hover {
            background: #15803d;
        }

        .back {
            display: inline-block;
            margin-top: 18px;
            color: #166534;
            text-decoration: none;
        }

        @media(max-width: 600px) {
            .container {
                margin: 20px;
                padding: 20px;
            }
        }
    </style>
</head>

<body>

    <nav>
        <a href="/dashboard">← Back to Dashboard</a>
    </nav>

    <div class="container">

        <h1>🟢 Report Found Item</h1>
        <p class="subtitle">
            Found something? Submit its details to help the owner recover it.
        </p>

        <form action="/report-found" method="POST"
              enctype="multipart/form-data">

            <label>Item Name</label>
            <input type="text" name="itemName"
                   placeholder="Enter item name" required>

            <label>Category</label>
            <select name="category" required>
                <option value="">Select Category</option>
                <option value="Electronics">Electronics</option>
                <option value="Documents">Documents</option>
                <option value="Bags">Bags</option>
                <option value="Jewellery">Jewellery</option>
                <option value="Clothing">Clothing</option>
                <option value="Other">Other</option>
            </select>

            <label>Description</label>
            <textarea name="description"
                      placeholder="Describe the found item"
                      required></textarea>

            <label>Date Found</label>
            <input type="date" name="foundDate" required>

            <label>Found Location</label>
            <input type="text" name="location"
                   placeholder="Where did you find it?" required>

            <label>Contact Number</label>
            <input type="tel" name="contact"
                   placeholder="Enter contact number" required>

            <label>Upload Item Image (Optional)</label>
            <input type="file" name="itemImage" accept="image/*">

            <button type="submit">Submit Found Item</button>

        </form>

        <a class="back" href="/dashboard">Back to Dashboard</a>

    </div>

</body>
</html>