<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Lost Items</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f1f7f2;
            margin: 0;
            padding: 20px;
        }
        .container {
            max-width: 1100px;
            margin: 25px auto;
            background: white;
            padding: 20px;
            border-radius: 10px;
            overflow-x: auto;
        }
        h1 { color: #075b2a; text-align: center; }
        table { width: 100%; border-collapse: collapse; }
        th, td {
            padding: 12px;
            border: 1px solid #ddd;
            text-align: left;
        }
        th { background: #075b2a; color: white; }
        tr:nth-child(even) { background: #f1f8f2; }
        img { width: 70px; height: 60px; object-fit: cover; }
        a { color: #075b2a; text-decoration: none; font-weight: bold; }
        button {
            background: #c62828;
            color: white;
            border: none;
            padding: 8px 12px;
            border-radius: 5px;
            cursor: pointer;
        }
    </style>
</head>
<body>
<div class="container">
    <a href="/admin-dashboard">← Back to Admin Dashboard</a>
    <h1>Manage Lost Items</h1>

    <% if (!items || items.length === 0) { %>
        <p>No lost-item reports found.</p>
    <% } else { %>
        <table>
            <tr>
                <th>ID</th>
                <th>Item Name</th>
                <th>Category</th>
                <th>Location</th>
                <th>Lost Date</th>
                <th>Contact</th>
                <th>Image</th>
                <th>Action</th>
            </tr>
            <% items.forEach(item => { %>
                <tr>
                    <td><%= item.id %></td>
                    <td><%= item.item_name %></td>
                    <td><%= item.category %></td>
                    <td><%= item.location %></td>
                    <td><%= item.lost_date %></td>
                    <td><%= item.contact %></td>
                    <td>
                        <% if (item.image) { %>
                            <img src="/uploads/<%= item.image %>" alt="Lost item">
                        <% } else { %>
                            No image
                        <% } %>
                    </td>
                    <td>
                        <form action="/admin-delete-lost/<%= item.id %>"
                              method="POST"
                              onsubmit="return confirm('Are you sure you want to delete this lost item?');">
                            <button type="submit">Delete</button>
                        </form>
                    </td>
                </tr>
            <% }) %>
        </table>
    <% } %>
</div>
</body>
</html>